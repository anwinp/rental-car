# ─── Stage 1: same builder as API ──────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --prefix=/install --no-cache-dir -r requirements.txt


# ─── Stage 2: worker runtime ───────────────────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --no-create-home appuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser alembic/ ./alembic/

USER appuser

# WORKER_QUEUES env var controls which queues this container services.
# Beat container uses BEAT=true and omits WORKER_QUEUES.
# Examples:
#   WORKER_QUEUES=notifications            → notification worker
#   WORKER_QUEUES=rate_filing,toll_processing → rate-filing worker
#   WORKER_QUEUES=reports,batch            → reports worker
#   BEAT=true                              → beat scheduler (no queue)
CMD ["sh", "-c", "\
  if [ \"${BEAT:-false}\" = 'true' ]; then \
    exec celery -A app.worker.celery_app beat \
      --scheduler redbeat.RedBeatScheduler \
      --loglevel=info; \
  else \
    exec celery -A app.worker.celery_app worker \
      --queues=${WORKER_QUEUES} \
      --concurrency=${WORKER_CONCURRENCY:-4} \
      --loglevel=info \
      --without-gossip \
      --without-mingle; \
  fi"]
