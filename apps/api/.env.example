# API-specific environment variables
# Copy to .env for local development — never commit .env

ENV=development

# Database (points to pgbouncer in docker-compose)
DATABASE_URL=postgresql+asyncpg://rcm:rcm_dev_password@localhost:5433/rcm_dev

# Redis clusters (separate instances for different roles)
REDIS_AVAIL_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0
REDIS_SESSION_URL=redis://localhost:6381/0

# JWT authentication
JWT_SECRET_KEY=replace-with-at-least-64-hex-chars-256-bit-secret-key-never-commit
JWT_ALGORITHM=HS256

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Stripe payment processing
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# Avalara tax calculation
AVALARA_ACCOUNT_ID=0000000
AVALARA_LICENSE_KEY=replace_with_avalara_license_key
AVALARA_COMPANY_CODE=REPLACE

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=+15550000000

# SendGrid email
SENDGRID_API_KEY=SG.replace_with_sendgrid_api_key

# AWS
AWS_REGION=us-east-1
S3_DOCUMENTS_BUCKET=rcm-dev-documents
S3_PHOTOS_BUCKET=rcm-dev-photos
S3_REPORTS_BUCKET=rcm-dev-reports

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO

# Server
PORT=8000
WORKER_COUNT=2
APP_VERSION=local
