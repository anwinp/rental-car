# ─────────────────────────────────────────────────────────────────────────────
# RCM production env — copy to deploy/.env.prod and fill REAL values.
#   cp deploy/.env.prod.example deploy/.env.prod   &&   chmod 600 deploy/.env.prod
# deploy/.env.prod is gitignored. NEVER commit real secrets.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres / tenant ────────────────────────────────────────────────────────
# `rcm` OWNS the schema. It is used for migrations and nothing else.
POSTGRES_DB=rcm
POSTGRES_USER=rcm
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
TENANT_ID=00000000-0000-0000-0000-000000000001   # matches seed data + frontend defaults

# ── Runtime database role ────────────────────────────────────────────────────
# The application must NOT connect as the schema owner. Owners and superusers
# bypass row-level security, so every tenant-isolation policy in the database
# becomes decorative — one tenant's request returns every tenant's rows, and
# no test catches it because the policies exist and look correct.
#
# `app_user` is created by migration 052 with NOSUPERUSER and NOBYPASSRLS
# explicitly stripped. That migration reads APP_DB_PASSWORD and now REFUSES to
# run in production without it, rather than falling back to a password that is
# committed to this repository.
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME_strong_app_user_password

# ── Database URLs (consumed by the API container; compose also derives these) ─
# App traffic goes through pgbouncer (transaction pooling) as the RUNTIME role.
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME_strong_app_user_password@pgbouncer:5433/rcm
# Migrations & seeding connect DIRECTLY to postgres as the OWNER (DDL and
# advisory locks must not go through a transaction-pooled pgbouncer, and
# creating policies requires ownership). Used by deploy/init-data.sh.
DIRECT_DATABASE_URL=postgresql+asyncpg://rcm:CHANGE_ME_strong_db_password@postgres:5432/rcm

# ── JWT (>= 64 hex chars) ────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_64
JWT_ALGORITHM=HS256

# ── CORS — the RCM subdomains (same-origin proxy makes this mostly belt-and-braces)
# MUST be a JSON array. cors_origins is typed list[str], and pydantic-settings
# json.loads() complex types inside the env source — before the comma-splitting
# field_validator in config.py can run. A bare comma-separated string raises
# SettingsError at import and the API never starts.
CORS_ORIGINS=["https://rcm.ceez.ai","https://rcm-admin.ceez.ai","https://rcm-counter.ceez.ai"]
FRONTEND_URL=https://rcm.ceez.ai

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx   # build arg for booking

# ── Avalara (tax) ────────────────────────────────────────────────────────────
AVALARA_ACCOUNT_ID=0000000
AVALARA_LICENSE_KEY=xxx
AVALARA_COMPANY_CODE=DEFAULT
AVALARA_ENVIRONMENT=sandbox

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15550000000

# ── SendGrid (email) ─────────────────────────────────────────────────────────
# ── Outbound email ───────────────────────────────────────────────────────────
# app/core/mailer.py tries SMTP first, then SendGrid, then falls back to writing
# the message to the log and returning success. That fallback is why this must
# be filled in: with neither transport configured, signup verification, password
# resets and staff invitations all silently no-op behind an HTTP 201, and
# because login refuses unverified workspaces, NO ACCOUNT CAN EVER BE ACTIVATED.
#
# Note the placeholder trap: mailer._is_placeholder() treats any value
# containing "xxx", "changeme", "placeholder" or "your-key" as unset. A literal
# `SG.xxx` here reads as "no SendGrid configured", not as a broken key — which
# is how this went unnoticed. The same applies to Stripe, Avalara and Twilio.
#
# The other stacks on this host (cstg-api, ceezstg-api) already send through
# Gmail with an app password; the same credential works here.
#
# CAVEAT: that is a personal Gmail account with a ~500 message/day cap and it
# stamps "sent via gmail.com" on tenant-facing mail. Fine to launch on, wrong
# for a growing customer base — move to a domain-authenticated sender (SendGrid,
# SES, Postmark) with SPF/DKIM on ceez.ai before volume matters.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_account
SMTP_PASSWORD=CHANGE_ME_gmail_app_password
SMTP_START_TLS=true
SMTP_FROM_EMAIL=noreply@ceez.ai
SMTP_FROM_NAME=Rental Car Manager

# Alternative transport, used only if SMTP_HOST is empty. Leave blank rather
# than writing a placeholder — a placeholder and a blank behave identically, but
# a blank does not read like it is configured.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ceez.ai

# ── Public URLs handed to customers ──────────────────────────────────────────
# These build the workspace links in the signup confirmation screen and in
# /public/config, which every frontend fetches at boot. They default to
# localtest.me — leaving them unset tells a paying customer their workspace
# lives at http://acme.localtest.me:3400.
PUBLIC_URL_SCHEME=https
PUBLIC_BOOKING_HOST=rcm.ceez.ai
PUBLIC_ADMIN_HOST=rcm-admin.ceez.ai

# ── Object storage = RCM's OWN MinIO container (S3-compatible) ───────────────
AWS_REGION=us-east-1
S3_DOCUMENTS_BUCKET=rcm-documents
S3_PHOTOS_BUCKET=rcm-photos
S3_REPORTS_BUCKET=rcm-reports
# These become the rcm-minio root credentials AND the app's S3 credentials.
# They are NEW values you choose — unrelated to any other stack's MinIO.
#   openssl rand -hex 20   # for the secret
AWS_ACCESS_KEY_ID=CHANGE_ME_rcm_minio_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_rcm_minio_secret_key
# Internal endpoint for server-side calls (API/worker -> rcm-minio over docker net):
S3_ENDPOINT_URL=http://rcm-minio:9000
# Public endpoint that browser-facing PRESIGNED URLs must be signed against:
S3_PUBLIC_ENDPOINT=https://rcm-files.ceez.ai
# Path-style addressing + SigV4 are applied automatically whenever
# S3_ENDPOINT_URL is set (see apps/api/app/core/s3.py).

# ── Optional: AI agent / LLM (leave blank to disable) ────────────────────────
ANTHROPIC_API_KEY=
LLM_API_KEY=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
