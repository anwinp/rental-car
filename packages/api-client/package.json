{
  "name": "@rcm/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts --out-dir dist",
    "generate": "openapi-typescript http://localhost:8000/api/openapi.json -o src/schema.d.ts && node -e \"const f='src/schema.d.ts',s=require('fs');s.writeFileSync(f,s.readFileSync(f,'utf8').split('\\\"/api/v1/').join('\\\"/'))\"",
    "generate:staging": "openapi-typescript $STAGING_API_URL/api/openapi.json -o src/schema.d.ts",
    "drift-check": "openapi-typescript http://localhost:8000/api/openapi.json -o /tmp/schema-fresh.d.ts && diff src/schema.d.ts /tmp/schema-fresh.d.ts && echo 'No drift' || (echo 'DRIFT DETECTED \u2014 run npm run generate' && exit 1)",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.12.2",
    "@tanstack/react-query": "5.59.15"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "tsup": "^8.3.5",
    "openapi-typescript": "7.4.1",
    "@rcm/eslint-config": "*",
    "eslint": "^8.57.0"
  }
}
