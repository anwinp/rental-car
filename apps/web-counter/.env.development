# Fallback tenant for plain http://localhost:PORT only, where the hostname
# carries no workspace label to resolve from.
#
# This is now consulted LAST. It previously outranked the hostname, so every
# request made before the app resolved its workspace was stamped with this id
# regardless of which tenant subdomain you were on — on acme-iso.localtest.me
# the boot requests spoke for test-rental-co.
#
# To work as a specific tenant, use its hostname instead:
#   http://<slug>.localtest.me:3002   (admin)
#   http://<slug>.localtest.me:3001   (counter)
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001
