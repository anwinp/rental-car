{
  "name": "@rcm/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs",
      "types": "./dist/auth/index.d.ts"
    },
    "./query": {
      "import": "./dist/query/index.js",
      "require": "./dist/query/index.cjs",
      "types": "./dist/query/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/auth/index.ts src/query/index.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts src/auth/index.ts src/query/index.ts --watch --format esm,cjs --dts --out-dir dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "5.59.15",
    "@tanstack/react-query-devtools": "5.59.15",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react-router-dom": "^6.27.0",
    "tailwind-merge": "^2.5.3",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.8",
    "@rcm/api-client": "*",
    "@rcm/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "vitest": "2.1.2",
    "@testing-library/react": "^16.0.1",
    "tailwindcss": "3.4.13",
    "@rcm/eslint-config": "*",
    "eslint": "^8.57.0"
  }
}
