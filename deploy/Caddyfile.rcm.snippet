# ─────────────────────────────────────────────────────────────────────────────
# RCM — append to /root/ceez_ai_beta_launch/ceez-ai-main/Caddyfile on the VM.
#
# Hyphenated single-label hosts (rcm-admin.ceez.ai), matching the existing
# netpulse-staging / ingest-staging convention, rather than nested
# admin.rcm.ceez.ai. One flat A record each, and HTTP-01 issuance works without
# the wildcard/DNS-01 complication a nested scheme would invite.
#
# Upstreams resolve by container name because workforce-caddy is connected to
# the rcm_internal network:
#     docker network connect rcm_internal workforce-caddy
#
# NOTE ON RELOADING (important on this host): /etc/caddy/Caddyfile inside
# workforce-caddy is a single-file bind mount that has gone stale — the host
# file was replaced, so the container still holds the old, unlinked inode and
# does NOT see edits to the host file. Until the container is recreated, apply
# config by copying it in and reloading from that path:
#     docker cp <file> workforce-caddy:/tmp/Caddyfile
#     docker exec workforce-caddy caddy validate --config /tmp/Caddyfile
#     docker exec workforce-caddy caddy reload   --config /tmp/Caddyfile
#
# PREREQUISITE: each name must resolve to this VM's public IP before its block
# is added. Caddy requests a Let's Encrypt cert on first request per host, and
# repeated failures for a non-resolving name count against LE rate limits.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PER-TENANT HOSTS — hyphenated, one certificate each, issued on demand
#
# Shape:  <slug>-rcm.ceez.ai        storefront   ->  rcm-booking
#         <slug>-rcm-admin.ceez.ai  back office  ->  rcm-admin
#
# e.g.    acme-rcm.ceez.ai  /  acme-rcm-admin.ceez.ai
#
# Hyphenated rather than nested (acme.rcm.ceez.ai) so every tenant host sits
# directly under ceez.ai. Combined with on-demand TLS this means NO WILDCARD
# CERTIFICATE and no DNS-01 challenge: Caddy obtains an ordinary HTTP-01
# certificate per hostname, the first time each one is visited. Nothing needs a
# DNS provider API token, and the same mechanism later serves a customer's own
# domain (book.acmerentals.com) with no further work.
#
# app/core/tenancy.py::extract_slug strips the platform suffix, so
# "acme-rcm-admin" resolves to tenant "acme". The platform hosts themselves
# (rcm.ceez.ai, rcm-admin.ceez.ai) resolve to no tenant, by design.
#
# ── THE ask GATE IS NOT OPTIONAL ────────────────────────────────────────────
# on_demand_tls without `ask` is an open certificate-issuance relay: anyone who
# points a DNS record at this IP triggers a real Let's Encrypt order. Failed
# orders count against the limit for the WHOLE registered domain (50/week), so a
# stranger could exhaust the quota for ceez.ai and block renewal for every
# unrelated app on this host. The endpoint returns 200 only for a hostname whose
# slug matches a live tenant.
#
# ── DNS REQUIRED BEFORE ENABLING ────────────────────────────────────────────
# One A record per tenant, or a single wildcard covering them all:
#
#     *.ceez.ai        A     63.250.55.137      (covers every tenant host)
#   or, if a bare wildcard is too broad, one per tenant as they sign up:
#     acme-rcm.ceez.ai         A   63.250.55.137
#     acme-rcm-admin.ceez.ai   A   63.250.55.137
#
# A wildcard A RECORD is only DNS; it does not imply a wildcard CERTIFICATE and
# needs no DNS-01. Signup should create the records via the DNS provider's API
# if per-tenant records are preferred.
#
# Keep this block LAST — Caddy matches explicit host blocks first, so the
# platform hosts above are unaffected.
# ─────────────────────────────────────────────────────────────────────────────

# APPLIED IN PRODUCTION 2026-08-02. This is the live configuration, copied back
# from /root/ceez_ai_beta_launch/ceez-ai-main/Caddyfile after reload.
#
# Two corrections were needed against the draft above:
#
#   1. `interval` and `burst` are no longer supported inside on_demand_tls on
#      the installed Caddy; the ask gate is the whole rate-limiting mechanism
#      now. Leaving them in fails validation outright.
#
#   2. The storefront must split /api/v1 to the API IN CADDY. Leaving it to the
#      Next.js rewrite proxies server-side and rewrites Host to rcm-api:8000, so
#      extract_slug sees no tenant and every per-tenant storefront call fails to
#      resolve. Verified: with the split, /api/v1/locations/public on
#      test-rental-co-rcm.ceez.ai returns that workspace's locations with no
#      X-Tenant-ID header at all.
#
# The global options block must be FIRST in the Caddyfile; the tenant block LAST.

# Global options — must be the first block in the file.
# RCM per-tenant hosts get certificates on demand; the ask gate is what
# stops this being an open issuance relay against the ceez.ai rate limit.
{
	on_demand_tls {
		ask      http://rcm-api:8000/api/v1/internal/tls-allowed
	}
}

# ── RCM per-tenant hosts — MUST STAY LAST ────────────────────────────────
# Catch-all for <slug>-rcm.ceez.ai and <slug>-rcm-admin.ceez.ai. Every
# explicit host block above is matched first, so no existing app is affected.
https:// {
	tls {
		on_demand
	}
	@admin header_regexp host Host ^[a-z0-9-]+-rcm-admin\.ceez\.ai$
	handle @admin {
		handle /api/v1/* {
			reverse_proxy rcm-api:8000
		}
		handle {
			reverse_proxy rcm-admin:80
		}
	}
	# Storefront: <slug>-rcm.ceez.ai
	# /api/v1 is split off here rather than left to the Next.js rewrite. A Next
	# rewrite proxies server-side and sets Host to rcm-api:8000, so the tenant
	# slug is lost and the API cannot tell which workspace the request is for.
	# Caddy preserves the original Host, which is the whole basis of per-tenant
	# hostname resolution. /api/auth/* stays with Next — those are its own route
	# handlers, not FastAPI.
	handle /api/v1/* {
		reverse_proxy rcm-api:8000
	}
	handle {
		reverse_proxy rcm-booking:3000
	}
	encode zstd gzip
}


# Customer booking — Next.js SSR. Next handles its own /api/v1 + /api/auth.
# Note this is the APEX host: its first label is "rcm", a reserved slug, so no
# tenant resolves here. That is intentional — this is the marketing/entry host,
# and tenant traffic arrives on the wildcard above.
rcm.ceez.ai {
	reverse_proxy rcm-booking:3000
	encode zstd gzip
}

# Back-office admin — Vite SPA. Same-origin /api/v1 must reach the API so the
# session cookie stays first-party (@rcm/api-client calls the relative /api/v1).
rcm-admin.ceez.ai {
	handle /api/v1/* {
		reverse_proxy rcm-api:8000
	}
	handle {
		reverse_proxy rcm-admin:80
	}
	encode zstd gzip
}

# Counter PWA — Vite SPA. Same pattern.
rcm-counter.ceez.ai {
	handle /api/v1/* {
		reverse_proxy rcm-api:8000
	}
	handle {
		reverse_proxy rcm-counter:80
	}
	encode zstd gzip
}

# Direct API surface — Stripe/Twilio/SendGrid webhooks, OpenAPI at /api/docs,
# and /health.
rcm-api.ceez.ai {
	reverse_proxy rcm-api:8000
	encode zstd gzip
}

# Public endpoint for RCM's OWN MinIO — browser presigned uploads/downloads.
# The shared workforce-minio is untouched. Presigned URLs are signed against
# this exact host (S3_PUBLIC_ENDPOINT). No compression: object bodies are
# already-compressed binaries and Caddy must not alter them mid-transfer.
rcm-files.ceez.ai {
	request_body {
		max_size 100MB
	}
	reverse_proxy rcm-minio:9000
}
